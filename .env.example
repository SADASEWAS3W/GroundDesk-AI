# OpenAI — required for agent LLM and embedding generation
DASHSCOPE_API_KEY=your-dashscope-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Agent model — used by the Customer Success Agent (default: gpt-4o)
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1536
AGENTS_TRACING_DISABLED=true

# Database (Neon PostgreSQL) — must have pgvector extension enabled
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require

# Redis — caching layer for KB search, channel config, customer lookups
REDIS_URL=redis://localhost:6379

# Kafka (Upstash) — future feature, not required for agent
# KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
